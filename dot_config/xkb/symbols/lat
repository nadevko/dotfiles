// Belarusian Latin keyboard layout (us-by)
// Based on standard US QWERTY

default partial alphanumeric_keys
xkb_symbols "us-by" {
	include "us(basic)"
	name[Group1] = "Belarusian Latin (US QWERTY base)";

	key <AD07> { [ u, U, ubreve,     Ubreve     ] }; // u → ŭ / Ŭ
	key <AC04> { [ f, F, dead_caron, dead_caron ] }; // f → ˇ (haček)
	key <AC05> { [ g, G, dead_acute, dead_acute ] }; // g → ´ (akut)
};
